{
  "name": "digisaka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Digisaka AI: Black Sigatoka detection for banana farms, with an admin knowledge console",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --test \"server/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
